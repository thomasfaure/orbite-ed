# Copier en .env, puis renseigner la clé UNIQUEMENT sur le serveur.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Écoute locale. Pour un serveur sur le réseau local, renseigner son adresse réseau.
HOST=127.0.0.1
PORT=3210

# Journal de restart-nas.js (défaut : orbite.log à la racine du projet).
# ORBITE_LOG=
